{
  "id": "daily-limit-revenge-01",
  "title": {
    "en": "No Limit: Revenge Trades Dig Deeper",
    "bn": "Limit ছাড়া: revenge trade আরও গর্তে ফেলে"
  },
  "symbol": "EURUSD",
  "timeframe": "M15",
  "mode": "synthetic",
  "type": "trade-review",
  "bias": "bearish",
  "outcome": "loss",
