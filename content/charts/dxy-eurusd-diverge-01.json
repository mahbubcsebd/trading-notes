{
  "id": "dxy-eurusd-diverge-01",
  "title": {
    "en": "When EURUSD and DXY Rise Together",
    "bn": "EURUSD ও DXY একসঙ্গে ওঠে"
  },
  "symbol": "EURUSD",
  "timeframe": "H1",
  "mode": "synthetic",
  "type": "concept",
  "bias": "neutral",
