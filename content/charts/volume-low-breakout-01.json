 ],
 "caption": {
  "en": "Candle 39 closes above the range top, but tick volume is only 0.8x the recent average. Price slips back and the stop is hit at bar 44.",
  "bn": "৩৯ নম্বর candle range top-এর ওপরে close করে, কিন্তু tick volume গড়ের মাত্র 0.8 গুণ। দাম ফিরে আসে এবং 44 নম্বর bar-এ stop কাটে।"
 },
 "notes": {
  "en": "Illustrative synthetic data.",
  "bn": "এটি শিক্ষামূলক কাল্পনিক ডেটা।"
 },
 "explanation": {
  "en": "Low volume does not guarantee a failure, but it removes the extra confirmation. The breakout stands alone on price.",
  "bn": "কম volume ব্যর্থতার গ্যারান্টি নয়, কিন্তু অতিরিক্ত নিশ্চিতকরণ সরিয়ে দেয়। Breakout তখন শুধু দামের ওপর দাঁড়ায়।"
 },
 "keyTakeaways": [
  {
   "en": "Weak volume is a reason to size down or wait, not an automatic sell",
   "bn": "দুর্বল volume মানে size কমানো বা অপেক্ষা, স্বয়ংক্রিয় sell নয়"
  }
 ],
