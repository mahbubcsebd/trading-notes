  "title": {
    "en": "Six Trades in a Range",
    "bn": "Range-এ ছয়টি trade"
  },
  "symbol": "EURUSD",
  "timeframe": "H1",
  "mode": "synthetic",
  "type": "trade-setup",
  "bias": "neutral",
  "outcome": "loss",
