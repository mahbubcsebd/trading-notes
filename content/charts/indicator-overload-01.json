  "07-indicator-overload"
 ],
 "caption": {
  "en": "Three EMAs, Bollinger Bands and RSI on one chart. They disagree at almost every bar and the candles disappear behind the lines.",
  "bn": "তিনটি EMA, Bollinger Bands ও RSI এক chart-এ। প্রায় প্রতিটি bar-এ তারা ভিন্ন কথা বলে এবং candle লাইনের আড়ালে হারিয়ে যায়।"
 },
 "notes": {
  "en": "Illustrative synthetic data.",
  "bn": "এটি শিক্ষামূলক কাল্পনিক ডেটা।"
 },
 "explanation": {
  "en": "Every indicator is built from the same price. Adding more of them repeats the same information in different shapes.",
  "bn": "প্রতিটি indicator একই দাম থেকে তৈরি। আরও যোগ করা মানে একই তথ্য ভিন্ন আকারে বারবার দেখা।"
 },
 "keyTakeaways": [
  {
   "en": "More indicators do not add information, they add noise",
   "bn": "বেশি indicator তথ্য বাড়ায় না, noise বাড়ায়"
  }
 ],
