{
  "id": "automation-overfit-equity-01",
  "title": {
    "en": "Great In-Sample, Poor Out-of-Sample",
    "bn": "In-sample-এ দারুণ, out-of-sample-এ দুর্বল"
  },
  "symbol": "ACCOUNT",
  "timeframe": "per trade",
  "mode": "synthetic",
  "type": "concept",
  "bias": "neutral",
  "outcome": "loss",
