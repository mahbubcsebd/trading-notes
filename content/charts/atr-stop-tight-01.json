 ],
 "caption": {
  "en": "The same buy, but the stop is only 0.5 x ATR below (10 pips). Ordinary noise hits it at bar 53, then price continues up.",
  "bn": "একই buy, কিন্তু stop মাত্র 0.5 x ATR নিচে (10 pip)। সাধারণ noise 53 নম্বর bar-এ সেটি কাটে, তারপর দাম ওপরে চলে।"
 },
 "notes": {
  "en": "Illustrative synthetic data.",
  "bn": "এটি শিক্ষামূলক কাল্পনিক ডেটা।"
 },
 "explanation": {
  "en": "The idea was right and the trade still lost: the stop was inside normal market noise.",
  "bn": "ধারণা ঠিক ছিল, তবুও trade হারল: stop ছিল স্বাভাবিক noise-এর ভিতরে।"
 },
 "keyTakeaways": [
  {
   "en": "A stop inside the noise gets hit by chance, not by a wrong idea",
   "bn": "Noise-এর ভিতরের stop কাটে ভাগ্যে, ধারণা ভুল বলে নয়"
  }
 ],
