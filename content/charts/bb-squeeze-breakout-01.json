  "05-bollinger-bands"
 ],
 "caption": {
  "en": "Bands narrow to 10 pips at bar 42, then a candle closes above the upper band at bar 43. Stop under the recent low, target 2R.",
  "bn": "42 নম্বর bar-এ band সংকুচিত হয়ে 10 pip, তারপর 43 নম্বর bar upper band-এর ওপরে close করে। Stop সাম্প্রতিক low-এর নিচে, target 2R।"
 },
 "notes": {
  "en": "Illustrative synthetic data.",
  "bn": "এটি শিক্ষামূলক কাল্পনিক ডেটা।"
 },
 "explanation": {
  "en": "A squeeze says volatility is low, not which way price will go. Wait for a close outside the band, then place the stop by structure.",
  "bn": "Squeeze বলে volatility কম, কোন দিকে যাবে তা বলে না। Band-এর বাইরে close-এর অপেক্ষা করুন, তারপর structure দিয়ে stop বসান।"
 },
 "keyTakeaways": [
  {
   "en": "A squeeze is a warning of a coming move, not a direction",
   "bn": "Squeeze আসন্ন চালের সতর্কবার্তা, দিক নয়"
  }
 ],
