  "id": "trail-structure-win-01",
  "title": {
    "en": "Trailing the Stop Under Each Higher Low",
    "bn": "প্রতিটি higher low-এর নিচে stop সরানো"
  },
  "symbol": "EURUSD",
  "timeframe": "H1",
  "mode": "synthetic",
  "type": "trade-setup",
  "bias": "bullish",
  "outcome": "win",
