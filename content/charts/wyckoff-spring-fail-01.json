  "id": "wyckoff-spring-fail-01",
  "title": {
    "en": "A 'Spring' That Was a Real Breakdown",
    "bn": "'Spring' ভেবে নেওয়া আসল breakdown"
  },
  "symbol": "EURUSD",
  "timeframe": "H1",
  "mode": "synthetic",
  "type": "trade-setup",
  "bias": "bullish",
  "outcome": "loss",
