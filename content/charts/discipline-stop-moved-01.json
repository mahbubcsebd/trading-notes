  "title": {
    "en": "Stop Moved Away",
    "bn": "Stop সরিয়ে দেওয়া"
  },
  "symbol": "EURUSD",
  "timeframe": "H1",
  "mode": "synthetic",
  "type": "trade-setup",
  "bias": "bullish",
  "outcome": "loss",
  "tags": [
    "discipline",
