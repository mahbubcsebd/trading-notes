{
  "id": "automation-ma-cross-01",
  "title": {
    "en": "A Rule-Based Signal: Trend Gains, Range Whipsaws",
    "bn": "নিয়মভিত্তিক সংকেত: trend-এ লাভ, range-এ whipsaw"
  },
  "symbol": "EURUSD",
  "timeframe": "H1",
  "mode": "synthetic",
  "type": "concept",
  "bias": "neutral",
  "outcome": "neutral",
