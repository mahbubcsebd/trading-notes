{
  "id": "size-wide-stop-01",
  "title": {
    "en": "Position Sizing: 40 Pip Stop = 0.25 Lot",
    "bn": "Position sizing: 40 pip stop = 0.25 lot"
  },
  "symbol": "EURUSD",
  "timeframe": "H4",
  "mode": "synthetic",
  "type": "trade-setup",
  "bias": "bullish",
  "outcome": "win",
  "tags": [
    "position-sizing",
    "stop-loss",
    "lot"
  ],
  "module": "08-risk-management",
  "lessonSlugs": [
    "02-position-sizing"
  ],
  "caption": {
    "en": "Account 10,000, risk 1% = 100. Stop 40 pips, pip value 10 per lot. Lot = 100 / (40 x 10) = 0.25.",
    "bn": "Account 10,000, ঝুঁকি 1% = 100। Stop 40 pip, প্রতি lot-এ pip মূল্য 10। Lot = 100 / (40 x 10) = 0.25।"
  },
  "notes": {
    "en": "Illustrative synthetic data.",
    "bn": "এটি শিক্ষামূলক কাল্পনিক ডেটা।"
  },
  "explanation": {
    "en": "A wider stop means a smaller lot, and the risk stays 100.",
    "bn": "Stop বড় হলে lot ছোট হয়, ঝুঁকি 100-ই থাকে।"
  },
  "keyTakeaways": [
    {
      "en": "Lot = risk amount / (stop pips x pip value)",
      "bn": "Lot = ঝুঁকির পরিমাণ / (stop pip x pip মূল্য)"
    }
  ],
